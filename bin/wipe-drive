#!/bin/bash

# Zero out a drive / disk and format it for use.
# Best run in sys-usb or whatever your equivalent is.
# The only required parameter is the `/dev` path to the drive.
# Use the `-q` flag if you want this to be a quick format.
# For filesystem, it defaults to exFAT, but you can set -e for ext4, -x for exFAT, or -f <type> for anything else.

if [ "$EUID" -ne 0 ]; then
  echo "Error: This script must be run as root (use sudo)."
  exit 1
fi

set -e
trap 'echo "[!] Error: A command failed. Script aborted to prevent damage." >&2' ERR

# Default Settings
QUICK_WIPE=0
FS_TYPE="exfat"
DEVICE=""

# Argument Parser
while [[ "$#" -gt 0 ]]; do
    case $1 in
        -q|--quick)
            QUICK_WIPE=1
            shift
            ;;
        -e|--ext4)
            FS_TYPE="ext4"
            shift
            ;;
        -x|--exfat)
            FS_TYPE="exfat"
            shift
            ;;
        -f|--fs)
            FS_TYPE="$2"
            shift 2
            ;;
        -*)
            echo "Error: Unknown option: $1"
            echo "Usage: sudo $0 [-q] [-e | -x | -f <fs_type>] <drive_path>"
            echo "Example 1: sudo $0 -q /dev/sda          (Quick wipe, defaults to exFAT)"
            echo "Example 2: sudo $0 -e /dev/sda          (Zero wipe, formats to ext4)"
            echo "Example 3: sudo $0 -q -f ntfs /dev/sda  (Quick wipe, formats to NTFS)"
            exit 1
            ;;
        *)
            DEVICE=$1
            shift
            ;;
    esac
done

if [ -z "$DEVICE" ]; then
  echo "Usage: sudo $0 [-q] [-e | -x | -f <fs_type>] <drive_path>"
  exit 1
fi

if [ ! -b "$DEVICE" ]; then
  echo "Error: $DEVICE is not a valid block device."
  exit 1
fi

# Ensure the requested mkfs utility is actually installed
if ! command -v mkfs."$FS_TYPE" &> /dev/null; then
    echo "[!] Error: 'mkfs.$FS_TYPE' command not found."
    echo "Please install the required formatting utilities for $FS_TYPE."
    exit 1
fi

BASENAME=$(basename "$DEVICE")
ROTATIONAL=$(cat "/sys/block/$BASENAME/queue/rotational" 2>/dev/null || echo "1")
DISCARD_GRAN=$(cat "/sys/block/$BASENAME/queue/discard_granularity" 2>/dev/null || echo "0")

echo "==================== DRIVE INFO ===================="
echo "Target device: $DEVICE"
echo "Filesystem:    $FS_TYPE"

if [ "$ROTATIONAL" = "0" ]; then
    echo "Type: Solid State / Flash (Non-rotational)"
else
    echo "Type: Hard Disk Drive (Rotational)"
fi

if [ -n "$DISCARD_GRAN" ] && [ "$DISCARD_GRAN" -gt 0 ]; then
    echo "TRIM/DISCARD Support: YES"
else
    echo "TRIM/DISCARD Support: NO"
fi
echo "===================================================="

lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINT "$DEVICE" || true
echo ""

if [ "$QUICK_WIPE" -eq 1 ]; then
    echo "WARNING: You are about to QUICK WIPE and format $DEVICE to $FS_TYPE."
else
    echo "WARNING: You are about to COMPLETELY ZERO OUT and format $DEVICE to $FS_TYPE."
fi

set +e
read -p "Type 'WIPE' to confirm: " confirm
set -e

if [ "$confirm" != "WIPE" ]; then
  echo "Aborted by user. No changes were made."
  exit 1
fi

# Execute Unmount and Wipe
echo "[*] Unmounting existing partitions..."
umount ${DEVICE}* 2>/dev/null || true

echo "[*] Wiping filesystem signatures..."
wipefs -a "$DEVICE" || true

if [ "$QUICK_WIPE" -eq 1 ]; then
    echo "[*] Quick Wipe: Overwriting the first 100MB..."
    dd if=/dev/zero of="$DEVICE" bs=1M count=100 status=none
elif [ "$ROTATIONAL" = "0" ] && [ -n "$DISCARD_GRAN" ] && [ "$DISCARD_GRAN" -gt 0 ]; then
    echo "[*] Fast Flash Erasure: Using blkdiscard..."
    blkdiscard -f "$DEVICE"
else
    echo "[*] Zeroing Erasure: Using dd (this may take a long time)..."
    dd if=/dev/zero of="$DEVICE" bs=4M status=progress
fi

# Format and Partition
echo "[*] Creating new GPT partition table..."
parted -s "$DEVICE" mklabel gpt
parted -s "$DEVICE" mkpart primary 0% 100%

# If it's a Windows-centric filesystem, add the msftdata flag
if [[ "$FS_TYPE" == "exfat" || "$FS_TYPE" == "ntfs" || "$FS_TYPE" == "vfat" || "$FS_TYPE" == "fat32" ]]; then
    parted -s "$DEVICE" set 1 msftdata on
fi

partprobe "$DEVICE"
sleep 2

if [[ "$DEVICE" =~ [0-9]$ ]]; then
    PARTITION="${DEVICE}p1"
else
    PARTITION="${DEVICE}1"
fi

echo "[*] Formatting $PARTITION to $FS_TYPE..."
if [ "$FS_TYPE" == "exfat" ]; then
    mkfs.exfat -n "USB_DRIVE" "$PARTITION"
elif [ "$FS_TYPE" == "ext4" ]; then
    mkfs.ext4 -q "$PARTITION"
else
    # Generic command for other filesystems (btrfs, xfs, etc.)
    mkfs."$FS_TYPE" "$PARTITION"
fi

# Fix Linux permissions ONLY if a native Linux filesystem was chosen
if [[ "$FS_TYPE" == "ext4" || "$FS_TYPE" == "btrfs" || "$FS_TYPE" == "xfs" ]]; then
    echo "[*] Native Linux FS detected. Granting write permissions to standard users..."
    TMP_MOUNT="/mnt/wipe_tmp_$$"
    mkdir -p "$TMP_MOUNT"
    
    mount "$PARTITION" "$TMP_MOUNT"
    chown -R 1000:1000 "$TMP_MOUNT"
    chmod -R 777 "$TMP_MOUNT"
    
    umount "$TMP_MOUNT"
    rmdir "$TMP_MOUNT"
fi

echo "[+] Success! $DEVICE is ready for use."